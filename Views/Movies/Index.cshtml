@model PaginatedList<WebMovies.Models.Movie>

@{
    ViewData["Title"] = "All Movies";
}

<h1 class="fw-semibold mt-4">All Movies</h1>
<form method="get">
    <div class="row">
        <div class="col-5">
            <input type="text" name="SearchString" class="form-control rounded ms-2" placeholder="Search..." />
        </div>
        <div class="col-1">
            <button asp-action="Index" type="submit" class="btn btn-primary">
                Search
            </button>
        </div>
    </div>
</form>
<br />

<div class="row row-cols-5 g-3 px-3">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card">
                <a asp-action="Details" asp-route-id="@item.Id">
                    <img src="@item.Poster" class="card-img"
                         alt="@item.Name Cover" />
                </a>
            </div>
        </div>
    }
</div>

@{
    var hasPreviousPage = !Model.HasPreviousPage ? "disabled" : "";
    var hasNextPage = !Model.HasNextPage ? "disabled" : "";
}

<div class="d-flex justify-content-center align-items-center m-3 h-100">
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @hasPreviousPage">
                <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.PageIndex - 1)" asp-route-searchString="@ViewBag.SearchString">&lsaquo;</a>
            </li>

            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                var activePage = i == Model.PageIndex ? "active" : "";
                <li class="page-item @activePage">
                    <a class="page-link" asp-action="Index" asp-route-pageIndex="@i" asp-route-searchString="@ViewBag.SearchString">@i</a>
                </li>
            }

            <li class="page-item @hasNextPage">
                <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.PageIndex + 1)" asp-route-searchString="@ViewBag.SearchString">&rsaquo;</a>
            </li>
        </ul>
    </nav>
</div>