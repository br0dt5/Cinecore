@model PaginatedList<WebMovies.Models.Movie>

@{
    ViewData["Title"] = "All Movies";
    var search = ViewBag.Search as WebMovies.Controllers.MoviesController.SearchOptions;
}

<h1 class="fw-semibold mt-4">All Movies</h1>
<form method="get">
    <div class="row">
        <div class="col-5">
            <input asp-for="@search.MovieTitle" class="form-control rounded ms-2" placeholder="Search..." />
        </div>
        <div class="col-1">
            <button asp-action="Index" type="submit" class="btn btn-primary">
                Search
            </button>
        </div>

        <div class="col-1">
            <button type="button" data-bs-toggle="collapse" data-bs-target="#searchOptions" class="btn btn-primary">Filters</button>
        </div>

        <div class="collapse mt-2" id="searchOptions">
            <div class="card card-body p-2">
                <div class="d-flex flex-row gap-2">
                    <input asp-for="@search.MovieGenre" class="form-control rounded-2" placeholder="Genre" />
                    <input asp-for="@search.ReleaseYear" class="form-control rounded-2" placeholder="Year" min="1900" />
                    <input asp-for="@search.MinScore" class="form-control rounded-2" placeholder="Score" min="1" max="10" />
                    <select asp-for="@search.SortOption" class="form-select w-auto">
                        <option value="">Sort</option>
                        <option value="ascending">Ascending</option>
                        <option value="descending">Descending</option>
                    </select>
                    <button asp-action="Index" type="submit" class="btn btn-primary flex-shrink-0">Apply Filters</button>
                </div>
            </div>
        </div>

    </div>
</form>
<br />

<div class="row row-cols-5 g-3 px-3">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card">
                <a asp-action="Details" asp-route-id="@item.Id">
                    <img src="@item.Poster" class="card-img"
                         alt="@item.Name Cover" />
                </a>
            </div>
        </div>
    }
</div>

@{
    var hasPreviousPage = Model.HasPreviousPage ? "" : "disabled";
    var hasNextPage = Model.HasNextPage ? "" : "disabled";
}

<div class="d-flex justify-content-center align-items-center m-3 h-100">
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @hasPreviousPage">
                <a class="page-link" asp-action="Index"
                   asp-route-pageIndex="@(Model.PageIndex - 1)"
                   asp-route-search.movieTitle="@search.MovieTitle"
                   asp-route-search.movieGenre="@search.MovieGenre"
                   asp-route-search.releaseYear="@search.ReleaseYear"
                   asp-route-search.sortOption="@search.SortOption">&lsaquo;</a>
            </li>

            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                var activePage = i == Model.PageIndex ? "active" : "";
                <li class="page-item @activePage">
                    <a class="page-link" asp-action="Index"
                       asp-route-pageIndex="@i"
                       asp-route-search.movieTitle="@search.MovieTitle"
                       asp-route-search.movieGenre="@search.MovieGenre"
                       asp-route-search.releaseYear="@search.ReleaseYear"
                       asp-route-search.sortOption="@search.SortOption">@i</a>
                </li>
            }

            <li class="page-item @hasNextPage">
                <a class="page-link" asp-action="Index"
                   asp-route-pageIndex="@(Model.PageIndex + 1)"
                   asp-route-search.movieTitle="@search.MovieTitle"
                   asp-route-search.movieGenre="@search.MovieGenre"
                   asp-route-search.releaseYear="@search.ReleaseYear"
                   asp-route-search.sortOption="@search.SortOption">&rsaquo;</a>
            </li>
        </ul>
    </nav>
</div>